          "type": "boolean",
          "label": "Surface prepared to standard"
        },
        {
          "key": "blast_standard",
          "type": "dropdown",
          "label": "Blast standard",
          "options": [
            {"value": "sa2_5", "label": "Sa 2.5"},
            {"value": "sa3", "label": "Sa 3"}
          ]
        }
      ]
    },
    {
