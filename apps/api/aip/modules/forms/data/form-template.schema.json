{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aip/contracts/forms/form-template.schema.json",
  "title": "Form template revision schema",
  "description": "The frozen JSON a form_revisions.schema holds (FORMS-01; schemaVersion 2 adds section rules, FORMS-10). Structural shape only: field-type names, units, option uniqueness, validation/type agreement, JSONLogic operators and reference/cycle checks are enforced by the forms lint, not here, so that e.g. an unknown field type surfaces as UNKNOWN_FIELD_TYPE rather than a schema error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sections"],
  "properties": {
    "schemaVersion": {"enum": [1, 2]},
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "allOf": [
    {
      "description": "Section rules arrive with schemaVersion 2; a version 1 template has none.",
      "if": {"properties": {"schemaVersion": {"const": 1}}},
      "then": {"properties": {"sections": {"items": {"not": {"required": ["rules"]}}}}}
    }
  ],
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "termKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "expression": {
      "description": "A JSONLogic operation. The allow-list and reference checks live in the lint.",
      "type": "object"
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "fields"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "label": {"$ref": "#/$defs/label"},
        "labelKey": {"$ref": "#/$defs/termKey"},
        "visibleIf": {"$ref": "#/$defs/expression"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/field"}
        },
        "rules": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/sectionRule"}
        }
      }
    },
    "sectionRule": {
      "description": "A check across a section's answers (FORMS-10): expr must be true for the section to pass; label (or labelKey) is the message shown when it is false. Its key shares the section and field key namespace.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "expr"],
      "anyOf": [{"required": ["label"]}, {"required": ["labelKey"]}],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "expr": {"$ref": "#/$defs/expression"},
        "label": {"type": "string", "minLength": 1, "maxLength": 1000},
        "labelKey": {"$ref": "#/$defs/termKey"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "type": {"$ref": "#/$defs/key"},
        "label": {"$ref": "#/$defs/label"},
        "labelKey": {"$ref": "#/$defs/termKey"},
        "helpKey": {"$ref": "#/$defs/termKey"},
        "required": {"type": "boolean"},
        "visibleIf": {"$ref": "#/$defs/expression"},
        "requiredIf": {"$ref": "#/$defs/expression"},
        "failWhen": {"$ref": "#/$defs/expression"},
        "failMessageKey": {"$ref": "#/$defs/termKey"},
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": {"$ref": "#/$defs/key"},
              "label": {"$ref": "#/$defs/label"},
              "labelKey": {"$ref": "#/$defs/termKey"}
            }
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "validations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"},
            "minLength": {"type": "integer", "minimum": 0, "maximum": 10000},
            "maxLength": {"type": "integer", "minimum": 0, "maximum": 10000},
            "minItems": {"type": "integer", "minimum": 0},
            "maxItems": {"type": "integer", "minimum": 0}
          }
        },
        "rules": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "messageKey", "message"],
            "properties": {
              "rule": {"$ref": "#/$defs/expression"},
              "messageKey": {"$ref": "#/$defs/termKey"},
              "message": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        }
      }
    }
  }
}
