# Environment variables for the API, worker and the local compose stack (STACK-05).
#
# Placeholders and obviously fake local dev values only: never put a real credential here or in a
# committed .env. Deployed environments (Coolify, AWS) take secrets from their secret stores.
#
# Compose: every variable below already has this default in infra/docker-compose.yml, so the
# stack runs without a .env file. To override, copy this file to .env and run
#   docker compose -f infra/docker-compose.yml --env-file .env up --build --wait
# Host-side tools (uv run uvicorn ..., pytest) read the same names from the shell environment;
# when running outside compose, swap the service hostnames (postgres, valkey, rustfs, gotenberg)
# for localhost.

# --- Build identity (baked into the API image; GET /api/v1/platform/version) ---------------------
# Full commit SHA of the build, e.g. GIT_SHA=$(git rev-parse HEAD). "unknown" for local builds.
GIT_SHA=unknown
# CI build or pipeline run id. "dev" for local builds.
BUILD_ID=dev
# Tag for the locally built aip-api, aip-web, aip-migrator and aip-sandbox images.
AIP_IMAGE_TAG=dev

# --- Application ---------------------------------------------------------------------------------
# development | test | staging | production (seeds refuse to run in production).
AIP_ENV=development
# Request-path database URL, as aip_app (the app engine refuses owner and privileged logins).
DATABASE_URL=postgresql://aip_app:aip_app_dev_only@postgres:5432/aip
# Migrator URL (DATABASE-08): aip_owner, direct to Postgres, never through PgBouncer.
DATABASE_MIGRATOR_URL=postgresql://aip_owner:aip_owner_dev_only@postgres:5432/aip
# Procrastinate jobs URL (ADR 0003): aip_jobs once DATABASE-02 lands.
DATABASE_JOBS_URL=postgresql://aip_owner:aip_owner_dev_only@postgres:5432/aip
# Valkey (Redis protocol): cache, rate limits, session cache, SSE pub/sub only.
REDIS_URL=redis://valkey:6379/0
# OTLP/HTTP collector for traces (OPS-04). Empty: tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Capabilities (STACK-02) ---------------------------------------------------------------------
# ObjectStore adapter: minio (RustFS/MinIO, path-style) | s3 (AWS S3 or LocalStack).
OBJECT_STORE=minio
OBJECT_STORE_BUCKET=aip
OBJECT_STORE_ENDPOINT_URL=http://rustfs:9000
# RustFS signs with us-east-1; AWS uses ap-southeast-2.
OBJECT_STORE_REGION=us-east-1
# Also the RustFS root credentials in compose. Dev-only placeholders.
OBJECT_STORE_ACCESS_KEY_ID=rustfs_dev_only
OBJECT_STORE_SECRET_ACCESS_KEY=rustfs_dev_only_secret
# PdfRenderer adapter: gotenberg.
PDF_RENDERER=gotenberg
GOTENBERG_URL=http://gotenberg:3000

# --- Postgres container (first start only) -------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
POSTGRES_DB=aip
# Password the bootstrap gives aip_owner (db/bootstrap/00_cluster.sql); must match the URLs above.
AIP_OWNER_PASSWORD=aip_owner_dev_only
# Password the bootstrap gives aip_app; must match DATABASE_URL.
AIP_APP_PASSWORD=aip_app_dev_only

# --- Keycloak (ADR 0005) -------------------------------------------------------------------------
KEYCLOAK_DB_PASSWORD=keycloak_dev_only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_dev_only
# Browser-facing origin of the web app: Keycloak redirect URIs and the OIDC callback (IDENTITY-01).
APP_ORIGIN=http://localhost:8080
# WebAuthn relying-party id: the APP_ORIGIN host.
WEBAUTHN_RP_ID=localhost
# Confidential clients in realm aip (aip-api: OIDC code flow; aip-admin: admin API) and the mock
# customer IdP brokers. Dev-only placeholders; deployed secrets come from the secret store.
AIP_API_CLIENT_SECRET=aip_api_dev_only_secret
AIP_ADMIN_CLIENT_SECRET=aip_admin_dev_only_secret
MOCK_IDP_CLIENT_SECRET=mock_idp_dev_only_secret
# Key for the sealed __Host-aip_preauth cookie: base64url of 32 random bytes, e.g.
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
# Empty: compose uses an obviously fake dev key, which the API refuses when AIP_ENV=production.
PREAUTH_COOKIE_KEY=

# --- Host ports (all bound to 127.0.0.1) ---------------------------------------------------------
AIP_API_PORT=8000
AIP_WEB_PORT=8080
AIP_POSTGRES_PORT=5432
AIP_VALKEY_PORT=6379
AIP_RUSTFS_PORT=9000
AIP_RUSTFS_CONSOLE_PORT=9001
AIP_GOTENBERG_PORT=3000
AIP_KEYCLOAK_PORT=8180
AIP_MAILPIT_PORT=8025
AIP_LOCALSTACK_PORT=4566
