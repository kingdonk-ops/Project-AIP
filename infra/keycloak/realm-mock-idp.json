{
  "realm": "mock-idp",
  "displayName": "Mock customer IdP (local dev and tests only)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "requiredActions": [
    { "alias": "UPDATE_PROFILE", "name": "Update Profile", "providerId": "UPDATE_PROFILE", "enabled": false, "defaultAction": false, "priority": 40, "config": {} },
    { "alias": "UPDATE_EMAIL", "name": "Update Email", "providerId": "UPDATE_EMAIL", "enabled": false, "defaultAction": false, "priority": 70, "config": {} },
    { "alias": "VERIFY_PROFILE", "name": "Verify Profile", "providerId": "VERIFY_PROFILE", "enabled": false, "defaultAction": false, "priority": 90, "config": {} },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": false, "defaultAction": false, "priority": 30, "config": {} },
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": false, "defaultAction": false, "priority": 10, "config": {} }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "attributes": {
    "aip.note": "IDENTITY-01: stands in for customer IdPs (kaefer-oidc, acme-oidc). Dev-only users and obviously fake passwords. Never import outside local dev and CI.",
    "aip.note.profile": "Review 11 H1: users cannot change their own email or names (UPDATE_PROFILE, UPDATE_EMAIL and VERIFY_PROFILE disabled, so kc_action is refused; profile attributes are admin-edit only). UPDATE_PASSWORD and CONFIGURE_TOTP are disabled too, so nobody holding the public passwords can lock the demo users out. The aip realm trusts this IdP's emails."
  },
  "clients": [
    {
      "clientId": "aip-broker-kaefer",
      "name": "AIP broker (kaefer-oidc)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MOCK_IDP_CLIENT_SECRET:mock_idp_dev_only_secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${KEYCLOAK_PUBLIC_URL:http://localhost:8180}/realms/aip/broker/kaefer-oidc/endpoint"],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "amr (IDENTITY-04: a customer IdP that enforces MFA)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "amr",
            "claim.value": "[\"pwd\",\"mfa\"]",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "false"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "aip-broker-acme",
      "name": "AIP broker (acme-oidc)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MOCK_IDP_CLIENT_SECRET:mock_idp_dev_only_secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${KEYCLOAK_PUBLIC_URL:http://localhost:8180}/realms/aip/broker/acme-oidc/endpoint"],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "amr (IDENTITY-04: a customer IdP that does not report MFA)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "amr",
            "claim.value": "[\"pwd\"]",
            "jsonType.label": "JSON",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "false"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "alice@kaefer.test",
      "email": "alice@kaefer.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Kaefer",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "alice_dev_only_password", "temporary": false }
      ]
    },
    {
      "username": "bob@acme.test",
      "email": "bob@acme.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Acme",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "bob_dev_only_password", "temporary": false }
      ]
    }
  ]
}
