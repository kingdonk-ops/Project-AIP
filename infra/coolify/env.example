# Coolify demo environment (OPS-11). Every variable infra/coolify/docker-compose.coolify.yml reads.
# DUMMY VALUES ONLY: set the real ones in Coolify (resource > Environment Variables), never here.
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# PREAUTH_COOKIE_KEY must be base64url of exactly 32 bytes:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"

# The demo origin (scheme + host, no trailing slash) and the WebAuthn relying party (its host).
APP_ORIGIN=https://aip-demo.example.test
WEBAUTHN_RP_ID=aip-demo.example.test

# Images pushed by .github/workflows/deploy-coolify.yml. AIP_IMAGE_TAG is `main` (latest) or a git
# SHA to pin or roll back.
IMAGE_REGISTRY=ghcr.io/kingdonk-ops
AIP_IMAGE_TAG=main

# Postgres superuser and the application roles (set on the first start of an empty volume only).
POSTGRES_PASSWORD=change-me-postgres
AIP_OWNER_PASSWORD=change-me-owner
AIP_APP_PASSWORD=change-me-app
AIP_JOBS_PASSWORD=change-me-jobs
# AUDIT-02: the worker writes the audit chains as aip_audit_writer.
AIP_AUDIT_WRITER_PASSWORD=change-me-audit-writer
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
BACKUP_RETENTION_DAYS=7

# Keycloak bootstrap admin (console reachable only inside the network) and the realm clients.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
AIP_API_CLIENT_SECRET=change-me-api-client
AIP_ADMIN_CLIENT_SECRET=change-me-admin-client
MOCK_IDP_CLIENT_SECRET=change-me-mock-idp
# SECURITY-11: the demo's mock-IdP users (alice@kaefer.test, bob@acme.test) get these passwords on
# every deploy (mock-idp-users). Set the coolify-demo environment's E2E_PASS_A/B to the same values.
MOCK_IDP_ALICE_PASSWORD=change-me-alice
MOCK_IDP_BOB_PASSWORD=change-me-bob

# Object store (RustFS) credentials.
OBJECT_STORE_ACCESS_KEY_ID=change-me-store-key
OBJECT_STORE_SECRET_ACCESS_KEY=change-me-store-secret

# App keys.
PREAUTH_COOKIE_KEY=replace-with-base64url-of-32-random-bytes
PROJECTS_CURSOR_KEY=change-me-cursor-key
ASSETS_CURSOR_KEY=change-me-cursor-key
