{
  "components": {
    "schemas": {
      "Dependencies": {
        "properties": {
          "alembic": {
            "title": "Alembic",
            "type": "string"
          },
          "fastapi": {
            "title": "Fastapi",
            "type": "string"
          },
          "postgres": {
            "title": "Postgres",
            "type": "string"
          },
          "procrastinate": {
            "title": "Procrastinate",
            "type": "string"
          },
          "pydantic": {
            "title": "Pydantic",
            "type": "string"
          },
          "python": {
            "title": "Python",
            "type": "string"
          },
          "sqlalchemy": {
            "title": "Sqlalchemy",
            "type": "string"
          }
        },
        "required": [
          "python",
          "fastapi",
          "pydantic",
          "sqlalchemy",
          "alembic",
          "procrastinate",
          "postgres"
        ],
        "title": "Dependencies",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Body of GET /api/v1/health. Changing it changes the generated client (STACK-03).",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginStartRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "returnTo": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Returnto"
          }
        },
        "required": [
          "email"
        ],
        "title": "LoginStartRequest",
        "type": "object"
      },
      "LoginStartResponse": {
        "additionalProperties": false,
        "description": "Same status and keys whether or not the email or domain is known; never the tenant.",
        "properties": {
          "method": {
            "enum": [
              "sso",
              "password"
            ],
            "title": "Method",
            "type": "string"
          },
          "redirectUrl": {
            "title": "Redirecturl",
            "type": "string"
          }
        },
        "required": [
          "method",
          "redirectUrl"
        ],
        "title": "LoginStartResponse",
        "type": "object"
      },
      "ModuleInfo": {
        "description": "A mounted module as reported by the registry.",
        "properties": {
          "context": {
            "title": "Context",
            "type": "string"
          },
          "depends_on": {
            "items": {
              "type": "string"
            },
            "title": "Depends On",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "context",
          "depends_on"
        ],
        "title": "ModuleInfo",
        "type": "object"
      },
      "TenantErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "TenantErrorBody",
        "type": "object"
      },
      "TenantErrorResponse": {
        "description": "Body of a 401/403 from ``require_active_tenant``. Never names the tenant.",
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/TenantErrorBody"
          }
        },
        "required": [
          "detail"
        ],
        "title": "TenantErrorResponse",
        "type": "object"
      },
      "TenantView": {
        "additionalProperties": false,
        "description": "The caller's tenant as other modules and the API see it.",
        "properties": {
          "deploymentShape": {
            "enum": [
              "pooled",
              "siloed"
            ],
            "title": "Deploymentshape",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "regionCode": {
            "title": "Regioncode",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "enum": [
              "provisioning",
              "active",
              "suspended",
              "offboarding",
              "offboarded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "regionCode",
          "deploymentShape",
          "status"
        ],
        "title": "TenantView",
        "type": "object"
      },
      "VersionResponse": {
        "description": "Body of GET /api/v1/platform/version. Changing it changes the generated client.",
        "properties": {
          "build": {
            "title": "Build",
            "type": "string"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "dependencies": {
            "$ref": "#/components/schemas/Dependencies"
          }
        },
        "required": [
          "build",
          "commit",
          "dependencies"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AIP API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login/start": {
      "post": {
        "operationId": "identity_login_start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginStartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginStartResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Login Start",
        "tags": [
          "identity"
        ],
        "x-aip-access": "public"
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "operationId": "identity_oidc_callback",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "Oidc Callback",
        "tags": [
          "identity"
        ],
        "x-aip-access": "public"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "platform_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "platform_live",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Platform Live",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "platform_ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency check failed"
          }
        },
        "summary": "Ready",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/v1/me/tenant": {
      "get": {
        "operationId": "tenancy_get_my_tenant",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantView"
                }
              }
            },
            "description": "The caller's active tenant."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantErrorResponse"
                }
              }
            },
            "description": "No authenticated principal, or no known tenant for it."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantErrorResponse"
                }
              }
            },
            "description": "The tenant is suspended, offboarded or not ready."
          }
        },
        "summary": "Get My Tenant",
        "tags": [
          "tenancy"
        ]
      }
    },
    "/api/v1/platform/modules": {
      "get": {
        "operationId": "platform_list_modules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModuleInfo"
                  },
                  "title": "Response Platform List Modules",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Modules",
        "tags": [
          "platform"
        ]
      }
    },
    "/api/v1/platform/version": {
      "get": {
        "operationId": "platform_version",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Version",
        "tags": [
          "platform"
        ]
      }
    }
  }
}
